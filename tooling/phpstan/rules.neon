parameters:
    ignoreErrors:
        -
            identifier: match.alwaysFalse
            paths:
                - ../../src/Support/Events/Log/Concerns/SerializesModels.php
services:
    -
        class: Tooling\EventLog\PhpStan\Extensions\DisablesSerializesModels
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Tooling\EventLog\PhpStan\RecordableMustHaveAlias
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\RecordableMustUseHasLoggable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\HasLoggableMustUseSerializesModels
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\HasLoggableMustImplementRecordable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\RecordableMustNotOverrideSerialization
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\TransportMustHaveDispatches
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\Collectors\TransportAliases
        tags:
            - phpstan.collector
    -
        class: Tooling\EventLog\PhpStan\Collectors\SwappableSubclasses
        tags:
            - phpstan.collector
    -
        class: Tooling\EventLog\PhpStan\TransportMustHaveUniqueAlias
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\NeedsEnvelopesMustUseCollectsEnvelopes
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\CollectsEnvelopesMustImplementNeedsEnvelopes
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\NeedsSentMustUseRecordsResult
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\RecordsResultMustImplementNeedsSent
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\TransportMustUseHasRelays
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\HasRelaysMustImplementTransport
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\DispatchesCollectingMustImplementNeedsEnvelopes
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\DispatchesSendingMustImplementNeedsSent
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\RecordableMustHaveIdentifiesLoggable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\RecordableMustHaveSingleIdentifiesLoggable
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\IdentifiesLoggableMustBeLoggableModel
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassMustDeclareUseFactory
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassFactoryMustExtendFactory
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassMustDeclareUseEloquentBuilder
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassBuilderMustExtendBuilder
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassMustDeclareCollectedBy
        tags:
            - phpstan.rules.rule
    -
        class: Tooling\EventLog\PhpStan\SwappableSubclassCollectionMustExtendCollection
        tags:
            - phpstan.rules.rule
