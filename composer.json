{
    "name": "aryeo/event-log",
    "description": "Records class-backed Laravel events to the database and relays them to external recipients.",
    "type": "library",
    "license": "MIT",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.43 || ^13",
        "aryeo/actions": "0.0.24",
        "aryeo/eloquent-state-machines": "0.0.35",
        "nesbot/carbon": "^3.11",
        "aryeo/tooling-laravel": "0.0.43",
        "phpstan/phpstan": "^2.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11",
        "brianium/paratest": "^7.14",
        "phpunit/phpunit": "^12.4.1 || ^13",
        "pestphp/pest": "^4.1",
        "orchestra/testbench-core": "^10.7 || ^11",
        "nunomaduro/collision": "<8.9.4"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support",
            "Tooling\\": "src/Tooling"
        },
        "exclude-from-classmap": [
            "/src/**/*Test.php",
            "/src/**/*TestCases.php",
            "tests/Fixtures/Tooling"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Events\\Log\\Providers\\Provider"
            ]
        },
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                },
                "rules": "tooling/phpstan/rules.neon"
            },
            "rector": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests",
                        "tooling"
                    ]
                }
            }
        }
    }
}
